<UserControl x:Class="NovaChat.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource AppBackgroundBrush}" MinHeight="620">
            <StackPanel Width="560" HorizontalAlignment="Center" Margin="28">
                <TextBlock Text="Settings" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Personalize how NovaChat looks and feels." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,22"/>
                <Border Padding="22" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="22" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Choose the theme that is easiest on your eyes." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,17"/>
                        <Button Content="☀   Light mode" Height="48" Margin="0,0,0,10" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Click="LightModeButton_Click"/>
                        <Button Content="☾   Dark mode" Height="48" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Click="DarkModeButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Padding="22" Margin="0,16,0,0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="22" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="About NovaChat" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Real-time conversations, presence and account tools — built as one focused desktop experience." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="←   Back to chat" Height="46" Margin="0,18,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="BackToChatButton_Click"/>
                <Button Content="↪   Log out" Height="46" Margin="0,10,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="LogoutButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>