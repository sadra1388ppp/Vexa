<Window x:Class="NovaChat.Client.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        Height="108"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">
    <Border Margin="2"
            Padding="16"
            CornerRadius="14"
            Background="#20242B"
            BorderBrush="#3A414C"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,7,0,0"
                       FontSize="13"
                       Foreground="#D7DCE3"
                       TextWrapping="Wrap"
                       MaxHeight="48" />
        </Grid>
    </Border>
</Window>
