<UserControl x:Class="NovaChat.Client.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="760" HorizontalAlignment="Center" Margin="30">
                <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="←" Width="42" Height="42" Style="{StaticResource IconButtonStyle}" Click="BackButton_Click" ToolTip="Back to chat"/>
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center"><TextBlock Text="Contacts" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Find people and start conversations." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                </Grid>
                <Border Padding="18" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBox x:Name="SearchTextBox" Height="46" FontSize="14" KeyDown="SearchTextBox_KeyDown"/><Button Grid.Column="1" Content="Search" Height="46" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="SearchButton_Click"/></Grid>
                </Border>
                <TextBlock Text="Search results" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="2,24,0,10"/>
                <ItemsControl x:Name="SearchResultsList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Padding="15" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="15" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding Username}" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding Email}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                            <Button Grid.Column="2" Content="Add" Height="34" Style="{StaticResource SecondaryButtonStyle}" Click="AddSearchResultButton_Click"/><Button Grid.Column="3" Content="Chat" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="ChatButton_Click" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="My contacts" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="2,22,0,10"/>
                <ItemsControl x:Name="ContactsList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Padding="15" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="15" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding Username}" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding Email}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                            <Button Grid.Column="2" Content="Chat" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="ChatContactButton_Click"/><Button Grid.Column="3" Content="Remove" Height="34" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveButton_Click" Margin="8,0,0,0" Foreground="{DynamicResource DangerBrush}"/>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock x:Name="StatusText" Margin="2,16,0,24" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>