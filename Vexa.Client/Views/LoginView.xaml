<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#0B1118">
    <UserControl.Resources>
        <Style x:Key="AuthFieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#B8C3D0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1,0,0,7"/>
        </Style>

        <Style x:Key="AuthTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="Background" Value="#0D141D"/>
            <Setter Property="BorderBrush" Value="#2B3949"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#D4A373"/>
            <Setter Property="SelectionBrush" Value="#665C4533"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="1,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#46586B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#D4A373"/>
                                <Setter TargetName="FieldBorder" Property="Background" Value="#111B27"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthPasswordBox" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="Background" Value="#0D141D"/>
            <Setter Property="BorderBrush" Value="#2B3949"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#D4A373"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="1,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#46586B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#D4A373"/>
                                <Setter TargetName="FieldBorder" Property="Background" Value="#111B27"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthPrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="#151A20"/>
            <Setter Property="Background" Value="#D4A373"/>
            <Setter Property="BorderBrush" Value="#E8C79C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E4B98D"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#F3DCC0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BD895D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthLinkButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#D4A373"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="LinkSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkSurface" Property="Background" Value="#1CD4A373"/>
                                <Setter Property="Foreground" Value="#F1D5B5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkSurface" Property="Background" Value="#30D4A373"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LoginRoot">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1118" Offset="0"/>
                <GradientStop Color="#111B27" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="42,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="0.92*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,30,0"
                    Padding="4,20,38,20"
                    BorderBrush="#263443"
                    BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="58" Height="58" CornerRadius="17" Background="#D4A373">
                            <TextBlock Text="V" FontSize="34" FontWeight="Bold" Foreground="#121820"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VEXA" FontSize="22" FontWeight="Bold" Foreground="#F5F7FA"/>
                            <TextBlock Text="MESSAGING, REIMAGINED" FontSize="9" FontWeight="Bold"
                                       Foreground="#D4A373" Margin="1,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Your conversations.&#10;Your space."
                               FontSize="39" FontWeight="SemiBold" Foreground="#F5F7FA"
                               LineHeight="47" TextWrapping="Wrap" Margin="0,42,0,15"/>
                    <TextBlock Text="A calmer place to connect, share ideas, and keep up with the people who matter."
                               FontSize="15" LineHeight="24" Foreground="#AAB7C5"
                               TextWrapping="Wrap" MaxWidth="410"/>

                    <Border Height="1" Background="#2A3949" Margin="0,30,0,22"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#1C2A38">
                                <TextBlock Text="01" FontSize="11" FontWeight="Bold" Foreground="#D4A373"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Simple by design" Foreground="#E7ECF2" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="The essentials, without the clutter." Foreground="#8594A4" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#1C2A38">
                                <TextBlock Text="02" FontSize="11" FontWeight="Bold" Foreground="#D4A373"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Your choices matter" Foreground="#E7ECF2" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Manage how people can reach you." Foreground="#8594A4" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="LoginCard"
                    Grid.Column="1"
                    Width="420"
                    MaxWidth="420"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#121C27"
                    BorderBrush="#2B3A4A"
                    BorderThickness="1"
                    CornerRadius="22">
                <StackPanel>
                    <Border Width="46" Height="4" CornerRadius="2" Background="#D4A373"
                            HorizontalAlignment="Center" Margin="0,0,0,23"/>
                    <TextBlock x:Name="SignInTitle" Text="Welcome back"
                               FontSize="27" FontWeight="SemiBold" Foreground="#F5F7FA"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SignInSubtitle" Text="Sign in to continue to Vexa."
                               FontSize="12" Foreground="#9DABBA"
                               HorizontalAlignment="Center" Margin="0,8,0,19"
                               TextAlignment="Center"/>
                    <Border Background="#1B2A38" BorderBrush="#304357" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" HorizontalAlignment="Center"
                            Margin="0,0,0,25">
                        <TextBlock x:Name="LoginEnvironmentText" Text="DEVELOPMENT"
                                   FontSize="9" FontWeight="Bold" Foreground="#E7C39E"/>
                    </Border>

                    <TextBlock Text="USERNAME, EMAIL OR PHONE" Style="{StaticResource AuthFieldLabel}"/>
                    <TextBox x:Name="UserIdTextBox" Style="{StaticResource AuthTextBox}"
                             Margin="0,0,0,19" MaxLength="254"/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource AuthFieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource AuthPasswordBox}"
                                 Margin="0,0,0,8" MaxLength="100"/>

                    <TextBlock x:Name="LoginStatusTextBlock" Text=""
                               Visibility="Collapsed" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="#AAB7C5" Margin="1,5,1,5"/>

                    <Button x:Name="LoginButton" Content="Sign in"
                            Style="{StaticResource AuthPrimaryButton}" Margin="0,14,0,0"
                            IsDefault="True" Click="LoginButton_Click"/>
                    <TextBlock Text="Secure sign-in to your Vexa account"
                               FontSize="10.5" Foreground="#7F8D9C"
                               HorizontalAlignment="Center" Margin="0,16,0,3"/>
                    <Button x:Name="CreateAccountButton" Content="Create a new account"
                            Style="{StaticResource AuthLinkButton}"
                            Click="CreateAccountButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
