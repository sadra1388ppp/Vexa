<UserControl x:Class="NovaChat.Client.Views.ManageUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="OwnerDeleteButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C94C4C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B83F3F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Background" Value="#8E3434"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Manage Users"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="View, search, edit and safely manage NovaChat accounts."
                           Margin="0,7,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="←  Back to Chat"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Height="42"
                    Click="BackButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Height="48">
                <Grid>
                    <TextBlock Text="⌕"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="SearchBox"
                             Margin="44,0,12,0"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Search by name, email or user ID"
                             FocusVisualStyle="{x:Null}"/>
                </Grid>
            </Border>
            <Button Grid.Column="1"
                    Content="↻  Refresh"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Height="48"
                    Margin="12,0,0,0"
                    Click="RefreshButton_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,8,10,10">
                        <TextBlock Text="Accounts"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="CountText"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="UsersList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="UsersList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        Click="UserRowButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="46" Height="46">
                                            <Border CornerRadius="23"
                                                    Background="{DynamicResource PrimarySoftBrush}">
                                                <TextBlock Text="{Binding Initials}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                            </Border>
                                            <Ellipse Width="11"
                                                     Height="11"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusBrush}"
                                                     Stroke="{DynamicResource PanelBackgroundBrush}"
                                                     StrokeThickness="2"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Email}"
                                                       Margin="0,3,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="›"
                                                   FontSize="24"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText"
                               Text="No users found."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="User Details"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="StatusText"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,20,0,0">
                            <Border Width="76"
                                    Height="76"
                                    CornerRadius="38"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource PrimarySoftBrush}">
                                <TextBlock x:Name="DetailInitialsText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock x:Name="DetailNameText"
                                       Margin="0,12,0,0"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="Select a user"/>
                            <TextBlock x:Name="DetailIdText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock Text="DISPLAY NAME"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="DisplayNameBox"
                                     Height="40"
                                     Margin="0,5,0,10"
                                     FocusVisualStyle="{x:Null}"/>

                            <TextBlock Text="EMAIL"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="EmailBox"
                                     Height="40"
                                     Margin="0,5,0,0"
                                     TextChanged="EmailBox_TextChanged"
                                     FocusVisualStyle="{x:Null}"/>
                            <TextBlock x:Name="EmailDuplicateText"
                                       Text="This email is already registered."
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,8"
                                       Visibility="Collapsed"/>

                            <TextBlock Text="PHONE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Grid>
                                <TextBox x:Name="PhoneBox"
                                         Height="40"
                                         Margin="0"
                                         TextChanged="PhoneBox_TextChanged"
                                         PreviewTextInput="PhoneBox_PreviewTextInput"
                                         DataObject.Pasting="PhoneBox_Pasting"
                                         FocusVisualStyle="{x:Null}"/>
                                <TextBlock x:Name="PhoneHintText"
                                           Text="09987654321"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Opacity="0.45"
                                           FontSize="10"
                                           Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>
                            <TextBlock x:Name="PhoneDuplicateText"
                                       Text="This phone number is already registered."
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,8"
                                       Visibility="Collapsed"/>

                            <TextBlock Text="USER ID"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="UserIdBox"
                                     Height="40"
                                     Margin="0,5,0,0"
                                     TextChanged="UserIdBox_TextChanged"
                                     FocusVisualStyle="{x:Null}"/>
                            <TextBlock x:Name="UsernameDuplicateText"
                                       Text="This username is already taken."
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,8"
                                       Visibility="Collapsed"/>

                            <TextBlock Text="BIO"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox x:Name="BioBox"
                                     Height="70"
                                     Padding="11,8"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource AppBackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Margin="0,5,0,0"
                                     FocusVisualStyle="{x:Null}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock Text="ACCOUNT OVERVIEW"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <Border Margin="0,8,0,0"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="USERNAME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="AccountUsernameText" Margin="0,3,12,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PHONE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="AccountPhoneText" Margin="0,3,0,0" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PASSWORD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="AccountPasswordText"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Passwords are protected and are never displayed in plaintext."
                                               Margin="0,5,0,0"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="CREATED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="DetailCreatedText" Margin="0,3,8,0" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="LAST SEEN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="DetailLastSeenText" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Margin="0,12,8,0">
                                        <TextBlock Text="MESSAGE PRIVACY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="AccountPrivacyText" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                        <TextBlock Text="GROUP INVITES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="AccountGroupAddsText" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="AVATAR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="AccountAvatarText"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="4" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveButton"
                                    Grid.Column="0"
                                    Content="Save Changes"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Height="42"
                                    Margin="0,0,5,0"
                                    IsEnabled="False"
                                    Click="SaveButton_Click"/>
                            <Button x:Name="CancelButton"
                                    Grid.Column="1"
                                    Content="Cancel"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Height="42"
                                    Margin="5,0,0,0"
                                    IsEnabled="False"
                                    Click="CancelButton_Click"/>
                        </Grid>

                        <Border Grid.Row="5"
                                Margin="0,18,0,0"
                                Padding="14"
                                CornerRadius="12"
                                Background="#1A9C3F3F"
                                BorderBrush="#5C9C3F3F"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DANGER ZONE"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="Delete this account"
                                               Margin="0,3,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Permanently removes the account and its owned data."
                                               Margin="0,3,10,0"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <Button x:Name="DeleteButton"
                                        Grid.Column="1"
                                        Content="Delete Account"
                                        Style="{StaticResource OwnerDeleteButtonStyle}"
                                        Height="40"
                                        IsEnabled="False"
                                        Click="DeleteButton_Click"/>
                            </Grid>
                        </Border>

                        <Button x:Name="ViewChatsButton"
                                Grid.Row="6"
                                Content="💬  View User Chats"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Height="42"
                                Margin="0,12,0,0"
                                IsEnabled="False"
                                Click="ViewChatsButton_Click"/>

                        <TextBlock Grid.Row="7"
                                   Text="User ID changes are propagated to existing chats and contacts. Account deletion cannot be undone."
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   LineHeight="16"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <TextBlock Grid.Row="8"
                                   x:Name="ValidationText"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
