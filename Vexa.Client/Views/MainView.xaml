<UserControl x:Class="NovaChat.Client.Views.MainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Background="{DynamicResource AppBackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="285"/><ColumnDefinition Width="*" MinWidth="520"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="16,14,16,14"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"><TextBlock Text="N" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0"><TextBlock Text="NovaChat" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccountTypeText" Text="User Account" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Content="•••" Style="{StaticResource IconButtonStyle}" Width="38" Height="38" ToolTip="More options"/></Grid>
<StackPanel Grid.Row="1"><Border Height="44" CornerRadius="13" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,9"><Grid><TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="SearchTextBox" Margin="38,0,8,0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="Search conversations"/></Grid></Border><Button Content="＋   New conversation" Height="43" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="10,0" Click="StartNewChatSafelyButton_Click"/></StackPanel>
<ScrollViewer Grid.Row="2" Margin="0,16,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="CONVERSATIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/><ItemsControl x:Name="ChatsList"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="68" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button Grid.Column="0" Height="64" Style="{StaticResource GhostButtonStyle}" Padding="0" HorizontalContentAlignment="Stretch" Click="ChatButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="44" Height="44"><Ellipse Fill="{DynamicResource SelectedChatBrush}"/><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding AvatarSource}" Width="44" Height="44" Stretch="UniformToFill" IsHitTestVisible="False"><Image.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/></Image.Clip></Image><Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Stroke="{DynamicResource PanelBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding OnlineVisibility}"/></Grid><Grid Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastMessage}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding UnreadVisibility}"><TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Grid></Button><Button Grid.Column="1" Content="•••" Style="{StaticResource IconButtonStyle}" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Delete this conversation" Click="DeleteSingleChatButton_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoChatsText" Text="No conversations yet" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0"/></StackPanel></ScrollViewer>
<Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><StackPanel><StackPanel x:Name="OwnerBottomPanel" Visibility="Collapsed"><TextBlock Text="OWNER CONTROL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/><Button Content="👥   Manage Users" Height="36" Margin="0,0,0,3" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="10,0" Click="ManageUsersButton_Click"/><Button Content="💬   All Chats" Height="36" Margin="0,0,0,7" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="10,0" Click="AllChatsButton_Click"/></StackPanel><Button Content="👤   Profile" Height="36" Margin="0,0,0,4" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="10,0" Click="ProfileButton_Click"/><Button Content="⚙   Settings" Height="36" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="10,0" Click="SettingsButton_Click"/></StackPanel></Border>
</Grid></Border>
<Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10"><Grid x:Name="ChatHeaderGrid" Cursor="Hand" PreviewMouseLeftButtonUp="ChatHeaderGroupInfoProfessional_Click"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Grid.Column="0" Width="48" Height="48" MouseLeftButtonUp="ChatHeaderAvatarDirect_Click"><Ellipse x:Name="ChatAvatarBackground" Fill="{DynamicResource SelectedChatBrush}"/><TextBlock x:Name="ChatAvatarInitialsText" Text="N" Foreground="{DynamicResource PrimaryBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ChatHeaderAvatarImage" Width="48" Height="48" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"><Image.Clip><EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/></Image.Clip></Image><Ellipse x:Name="ChatAvatarStatusDot" Width="12" Height="12" Fill="{DynamicResource SecondaryTextBrush}" Stroke="{DynamicResource PanelBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0" IsHitTestVisible="False"><TextBlock x:Name="ChatUserNameText" Text="Select a conversation" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="ChatStatusIndicator" Width="7" Height="7" Fill="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="ChatStatusText" Text="Offline" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False"><Button Content="⌕" Style="{StaticResource IconButtonStyle}" ToolTip="Search in conversation" IsHitTestVisible="False"/><Button Content="•••" Style="{StaticResource IconButtonStyle}" ToolTip="Conversation menu" IsHitTestVisible="False"/></StackPanel></Grid></Border>
<ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}" Padding="28,22" VerticalScrollBarVisibility="Auto" ScrollChanged="MessagesScrollViewer_ScrollChanged"><StackPanel x:Name="MessagesPanel"><Border CornerRadius="22" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="34" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,90,0,90"><StackPanel HorizontalAlignment="Center"><Border Width="72" Height="72" CornerRadius="24" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="💬" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Start a conversation" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,6"/><TextBlock Text="Choose a chat from the left, or create a new conversation to start messaging." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/><Button Content="＋   Start a new chat" Style="{StaticResource PrimaryButtonStyle}" Height="44" Margin="0,22,0,0" Click="StartNewChatSafelyButton_Click"/><Button x:Name="LoadOlderMessagesButton" Content="Load older messages" Visibility="Collapsed" Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Click="LoadOlderMessagesButton_Click"/></StackPanel></Border></StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
<StackPanel>
<Border x:Name="ForwardPanel" Visibility="Collapsed" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,10" Margin="0,0,0,8">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center"><TextBlock Text="↗" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
<TextBlock Text="Forward message" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
<TextBlock x:Name="ForwardSourceText" Text="" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
<TextBlock x:Name="ForwardModeHintText" Text="" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
</StackPanel>
<Button x:Name="ForwardCancelButton" Grid.Column="2" Content="×" Width="32" Height="32" Style="{StaticResource IconButtonStyle}" Click="ForwardCancelButton_Click" ToolTip="Cancel forwarding"/>
</Grid>
<Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="11" Padding="10,7" Margin="0,9,0,8">
<StackPanel>
<TextBlock x:Name="ForwardSourceContentText" Text="" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxHeight="54" Margin="0,4,0,0"/>
</StackPanel>
</Border>
<TextBlock x:Name="ForwardTargetText" Grid.Row="2" Text="This message will be forwarded in the current conversation." FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,2,2" TextTrimming="CharacterEllipsis"/>
</Grid>
</Border>
<Grid VerticalAlignment="Center">
<Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
<Button Content="＋" Style="{StaticResource IconButtonStyle}" ToolTip="Attach file" HorizontalAlignment="Left"/>
<Button Grid.Column="1" Content="🎤" Style="{StaticResource IconButtonStyle}" ToolTip="Voice message" HorizontalAlignment="Left"/>
<Border Grid.Column="2" Height="48" CornerRadius="16" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="4,0,10,0"><TextBox x:Name="MessageTextBox" Background="Transparent" BorderThickness="0" Padding="14,0" FontSize="14" VerticalContentAlignment="Center" KeyDown="MessageTextBox_KeyDown" ToolTip="Write a message"/></Border>
<Button x:Name="SendButton" Grid.Column="3" Content="Send  ➤" Height="46" Style="{StaticResource PrimaryButtonStyle}" Click="SendButton_Click" ToolTip="Send message"/>
</Grid>
</StackPanel>
</Border></Grid>
</Grid></UserControl>